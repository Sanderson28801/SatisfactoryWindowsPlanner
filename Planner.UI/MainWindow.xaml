<Window x:Class="Planner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Planner.UI"
        mc:Ignorable="d"
        Title="Satisfactory Factory Planner" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel Orientation="Vertical">

            <TextBlock Text="Target Item (e.g., Desc_Ingot):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="ItemInput" Height="30" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Items Per Minute:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountInput" Height="30" Margin="0,0,0,15" Padding="5"/>

            <Button x:Name="CalculateButton" Content="Calculate Factory" Height="40" 
                Background="#007ACC" Foreground="White" FontWeight="Bold"
                Click="CalculateButton_Click"/>

            <Separator Margin="0,20,0,20"/>

            <TextBlock x:Name="ErrorBlock"></TextBlock>

            <TextBlock Text="Production Tree:" FontWeight="Bold" Margin="0,0,0,5"/>

            <TreeView x:Name="FactoryTree" MinHeight="200" Background="#FAFAFA" BorderBrush="#CCCCCC">
            </TreeView>

        </StackPanel>
    </Grid>
</Window>
