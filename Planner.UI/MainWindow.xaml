<Window x:Class="Planner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify" 
        Title="Satisfactory Planner" Height="720" Width="1280">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Target Item:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ItemInput" Height="30" Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Items Per Minute:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="AmountInput" Height="30" Margin="0,0,0,15" Padding="5"/>

                <Button x:Name="CalculateButton" Content="Calculate Factory" Height="40" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold"
                        Click="CalculateButton_Click"/>
            </StackPanel>
        </Border>

        <nodify:NodifyEditor Grid.Column="1"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}">

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}" 
           BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{Binding Location}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate>
                    <nodify:Node Header="{Binding Title}">
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding RateText}" FontWeight="Bold" FontSize="8"/>
                        </StackPanel>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate>
                    <nodify:LineConnection Source="{Binding Source.Location}" 
                                       Target="{Binding Target.Location}" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

        </nodify:NodifyEditor>
    </Grid>
</Window>